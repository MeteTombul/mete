# Anthropic API anahtarınız — https://console.anthropic.com adresinden alın
ANTHROPIC_API_KEY=sk-ant-...

# İsteğe bağlı: Whisper model boyutu (tiny, base, small, medium, large-v3)
# Küçük = hızlı ama daha az doğru. Türkçe için en az "small" önerilir.
WHISPER_MODEL=small

# İsteğe bağlı: faster-whisper cihazı (cpu veya cuda)
WHISPER_DEVICE=cpu

# ─────────────────────────────────────────────────────────────
# Sosyal medya yükleme (opsiyonel) — hepsi resmî API + OAuth iledir.
# Şifre KULLANILMAZ. Kendi geliştirici uygulamanı oluşturup token verirsin.
# ─────────────────────────────────────────────────────────────

# TikTok Content Posting API access token (video.publish scope)
# TIKTOK_ACCESS_TOKEN=

# Instagram Graph API (Professional/Business hesap gerekir)
# IG_ACCESS_TOKEN=
# IG_USER_ID=

# YouTube: token dosya tabanlıdır — secrets/youtube_client_secret.json koy,
# ilk çalıştırmada tarayıcıda kendi hesabınla yetki ver (env değişkeni gerekmez).

